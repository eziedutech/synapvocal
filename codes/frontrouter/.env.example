APP_ENV=local
GIT_SHA=dev
# Local without Docker: http://localhost:8000. Docker compose: http://backpy:8000
BACKPY_INTERNAL_URL=http://localhost:8000

# Voluntary contributions (optional)
# Same value in backpy
INTERNAL_API_TOKEN=
# Signs the contributor session cookie
SESSION_SECRET=
# Firebase web app config (public values, sent to the browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
