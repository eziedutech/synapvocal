APP_ENV=local
GIT_SHA=dev
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
GOOGLE_CLOUD_PROJECT=cinemeridian
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.7-flash
# Path inside the container to the service account key file
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-synapvocal-backpy.json
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Voluntary contributions (optional; the Bridge works without them)
DATABASE_URL=postgresql+asyncpg://synapvocal:PASSWORD@POSTGRES_INTERNAL_HOST:5432/synapvocal
# Same value in frontrouter
INTERNAL_API_TOKEN=
STORAGE_BACKEND=s3
S3_BUCKET=sagemaker-us-east-1-350553112293
S3_REGION=us-east-1
S3_PREFIX=synapvocal/contributions/
# IAM user synapvocal-train (Zia, 18 Sep 2026), the same user that runs fine-tuning
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
